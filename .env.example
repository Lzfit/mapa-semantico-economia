TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BATCH_SIZE=250

# Redis (Upstash, REST). Obrigatório em produção na Vercel; local usa memória se vazio.
# Também aceitos: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
REDIS_URL=
REDIS_TOKEN=

# Proteções (opcionais; valores padrão abaixo)
# SEARCH_RATE_LIMIT_NEW_PER_MIN=10      buscas novas (não cacheadas) por IP por minuto
# SEARCH_RATE_LIMIT_ALL_PER_MIN=120     todas as buscas por IP por minuto
# JEV_MAX_CONCURRENT_SEARCHES=16        buscas simultâneas chegando ao Jev

# Opcional: sobrescreve o endpoint do Jev. Ignorado em produção na Vercel.
# JEV_API_URL=
